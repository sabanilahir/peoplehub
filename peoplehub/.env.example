# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit/kirim file .env.

# Koneksi PostgreSQL. Jika password berisi karakter khusus, URL-encode (mis. @ menjadi %40).
DATABASE_URL="postgresql://postgres:Password.123@localhost:5432/peoplehub?schema=public"

# Rahasia penanda token login. Isi string acak panjang (mis. 40+ karakter).
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="8h"
PORT=3100

# Kunci webhook punch fingerprint (dikirim mesin lewat header x-api-key).
PUNCH_API_KEY="ganti-dengan-string-acak-panjang"

# Akun admin awal, dibuat oleh `npm run db:seed` (dan dipakai `npm run sample:load`).
# Nilai di bawah hanya untuk DEMO. Ganti password-nya untuk penggunaan di luar komputer sendiri.
SEED_ADMIN_EMAIL="admin"
SEED_ADMIN_PASSWORD="pass123"

{
  "name": "peoplehub",
  "version": "0.1.0",
  "private": true,
  "description": "PeopleHub — HR engine modular terintegrasi Odoo",
  "scripts": {
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "sample:load": "node scripts/sample-data.mjs",
    "sample:reset": "node scripts/sample-reset.cjs",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
